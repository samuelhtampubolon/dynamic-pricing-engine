# Environment Configuration
APP_ENV=development
APP_DEBUG=true

# Server Host & Ports
HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Security & JWT Tokens
# Set a random value of at least 32 characters; leave empty for an ephemeral key.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Lakehouse Storage
DUCKDB_PATH=data/pricing_lakehouse.duckdb

# Guardrail & Safety Defaults
DEFAULT_MIN_MARGIN_PCT=0.20
MAX_Z_SCORE_TOLERANCE=5.0
MAX_SIMULATION_HORIZON=5000
