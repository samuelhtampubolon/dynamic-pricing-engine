# Copy to .env and adjust. Never commit .env.

# Environment: development | test | production
# Outside production the public demo credentials are used when TENANT_CREDENTIALS is empty,
# and the app refuses to start unless HOST is 127.0.0.1 / localhost.
APP_ENV=development
APP_DEBUG=false

# Server host & ports (loopback by default)
HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# JWT signing key: REQUIRED in production (>= 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to use an ephemeral per-process key.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Tenant client credentials: REQUIRED in production.
# Comma separated tenant_id:role:scrypt-hash entries; create a hash with
#   python -m src.credentials hash-secret
# Roles: pricing_analyst | growth_manager | revenue_admin
# Leave empty in development to use the documented local demo secrets.
TENANT_CREDENTIALS=

# Rate limiting & request size (OWASP API4)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
MAX_REQUEST_BYTES=32768

# Lakehouse storage
DUCKDB_PATH=data/pricing_lakehouse.duckdb
DUCKDB_READ_ONLY=false

# Guardrails, data quality & pricing policy
MAX_Z_SCORE_TOLERANCE=5.0
MAX_QUARANTINE_RATIO=0.20
COMPETITOR_ANCHOR_WEIGHT=0.30
SELL_THROUGH_MIN_DAYS=7
SELL_THROUGH_MAX_DAYS=45
PRIOR_ELASTICITY=-2.0
ANNUAL_DISCOUNT_RATE=0.10
